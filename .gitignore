# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data exports / large files
# NOTE:
# - CSV/Parquet under `data/` are intentionally versioned (or managed via Git LFS).
# - Generated exports should go under `out/`.
out/**/*.csv
out/**/*.parquet

# Notebooks
.ipynb_checkpoints/

# Local env / secrets
.env
.env.*
.streamlit/secrets.toml

# Spec Kit / agent prompts (may contain local credentials depending on tooling)
.codex/

# Local AI agent tooling (not needed in repo)
.claude/

# MkDocs generated site
site/
